{
  "name": "sofora",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "stop": "node scripts/stop.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "dev": "turbo run dev",
    "build": "pnpm backend:typecheck && turbo run build",
    "typecheck": "pnpm backend:typecheck && turbo run typecheck",
    "backend:typecheck": "tsc --noEmit -p convex/tsconfig.json",
    "backend:dev": "convex dev",
    "backend:push": "convex dev --once",
    "preview": "pnpm --filter @sofora/web preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/rate-limiter": "^0.4.2",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.128"
  }
}
